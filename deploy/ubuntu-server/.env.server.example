# OpenClaw Ubuntu/VPS environment template
#
# Copy to: ~/.openclaw/.env on the server that will run the gateway.
# Fill only the values you actually use. Do not commit real secrets.

# Required for remote access to the gateway.
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token

# Required for your chosen model provider.
# OpenRouter API for DeepSeek models:
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Optional alternatives. Leave commented out unless you use them.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Optional channel tokens. Only set the channels you enable in config.
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Optional path overrides.
# OPENCLAW_STATE_DIR=/home/openclaw/.openclaw
# OPENCLAW_CONFIG_PATH=/home/openclaw/.openclaw/openclaw.json
